# Node (testing only)
node_modules/
package.json
package-lock.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local

# Checkpoint directories — crash-recovery artifacts only, not used downstream.
# Final outputs live in data/step1-pfs-parquets/ and data/step2-ef-parquets/.
data/checkpoints/
data/checkpoints_v4/
dashboard/physics_results_v4.json

# Large JSON results (>100MB, exceed GitHub limit) — use parquet versions instead
# JSON versions are regenerated locally from parquets via convert_parquet_to_json.py
dashboard/overprocure_results.json
dashboard/demand_growth_results.json
dashboard/track_results.json

# Track analysis intermediates
data/track_checkpoint.json
data/track_checkpoint.json.tmp
dashboard/track_results.json.tmp

# Monolithic co2_results.json exceeds GitHub 100 MB limit.
# CO2 results now stored as per-ISO parquets in co2_results/ directory.
data/step5-post-processing/co2_results.json

# Legacy per-ISO/threshold/year JSON batch files (replaced by parquets)
data/step5-post-processing/co2_results/_config.json
data/step5-post-processing/co2_results/*_meta_*.json
data/step5-post-processing/co2_results/*_*_2025.json

# Large intermediate analysis JSONs — output-only, not consumed downstream
data/analysis_results.json
data/step5-post-processing/strategy1_consequential.json
data/step5-post-processing/strategy2_hourly.json
data/step5-post-processing/strategy3_annual.json

# Dispatch cache temp files (real .npz is kept, .tmp.npz is not)
data/step5-post-processing/dispatch_cache/*.tmp.npz

# LMP archetypes — write-only intermediate output of step6_compute_lmp_prices.py
# No downstream consumer; the _lmp.parquet files are the consumed artifacts.
data/step5-post-processing/lmp/*_archetypes.parquet

# Dashboard parquets — not consumed by any HTML/JS; data lives in shared-data.js
dashboard/physics_results_v4*.parquet
dashboard/eac_scarcity_results.json

# Stale copy location — scripts should write to dashboard/ or data/, not here
scripts/dashboard/

# Step 1 raw parquet exports are ignored locally; CI commits them with git add -f
data/step1-pfs-parquets/*
!data/step1-pfs-parquets/.gitkeep

# Zone manifest — runtime checkpoint file for step1c resumability; never track in git.
# Committing it causes add/add conflicts when squash-merging parallel ISO branches
# (each run generates a different code_hash). The downstream consumer is step1c itself
# during an active run — not any downstream pipeline step.
data/step1-pfs-parquets/*_zone_manifest.json

# Large consolidated EIA JSON files — use parquet versions instead
# Pipeline reads parquets via scripts/eia_data_io.py (JSON fallback preserved)
data/eia-930/eia_generation_profiles.json
data/eia-930/eia_demand_profiles.json
data/eia-930/eia_fossil_mix.json
# Per-year raw JSON files — large, regenerated by step0 fetch scripts
data/eia-930/eia_hourly_*.json
data/eia-930/eia_demand_*_*.json
data/eia-930/*_local.json
data/eia-930/*_backup.json

# CSV exports — large, regenerated from parquets on demand
data/csv-exports/
data/step5-post-processing/csv_exports/

# Archives — local comparison snapshots, not tracked in git
data/archive_*/
