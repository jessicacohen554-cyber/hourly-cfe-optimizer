# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local

# Checkpoint directories — crash-recovery artifacts only, not used downstream.
# Final outputs live in data/step1_raw_pfs_parquets/ and data/step-2-EF-parquets/.
data/checkpoints/
data/checkpoints_v4/
dashboard/physics_results_v4.json

# Large JSON results (>100MB, exceed GitHub limit) — use parquet versions instead
# JSON versions are regenerated locally from parquets via convert_parquet_to_json.py
dashboard/overprocure_results.json
dashboard/demand_growth_results.json
dashboard/track_results.json

# Track analysis intermediates
data/track_checkpoint.json
data/track_checkpoint.json.tmp
dashboard/track_results.json.tmp

# Dispatch cache temp files (real .npz is kept, .tmp.npz is not)
data/dispatch_cache/*.tmp.npz

# Dashboard parquets — not consumed by any HTML/JS; data lives in shared-data.js
dashboard/physics_results_v4*.parquet
dashboard/eac_scarcity_results.json

# Stale copy location — scripts should write to dashboard/ or data/, not here
scripts/dashboard/

# Step 1 raw parquet exports are ignored locally; CI commits them with git add -f
data/step1_raw_pfs_parquets/*
!data/step1_raw_pfs_parquets/.gitkeep
