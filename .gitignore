venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment
.env
.env.local

# Checkpoint directories — crash-recovery artifacts only, not used downstream.
# Final outputs live in data/step1-pfs-parquets/ and data/step2-ef-parquets/.
data/checkpoints/
data/checkpoints_v4/
dashboard/physics_results_v4.json

# Large JSON results (>100MB, exceed GitHub limit) — use parquet versions instead
# JSON versions are regenerated locally from parquets via convert_parquet_to_json.py
dashboard/overprocure_results.json
dashboard/demand_growth_results.json
dashboard/track_results.json

# Track analysis intermediates
data/track_checkpoint.json
data/track_checkpoint.json.tmp
dashboard/track_results.json.tmp

# Monolithic co2_results.json exceeds GitHub 100 MB limit.
# Batched per-ISO/threshold/year files in co2_results/ are used instead.
data/step5-post-processing/co2_results.json

# Dispatch cache temp files (real .npz is kept, .tmp.npz is not)
data/step5-post-processing/dispatch_cache/*.tmp.npz

# Dashboard parquets — not consumed by any HTML/JS; data lives in shared-data.js
dashboard/physics_results_v4*.parquet
dashboard/eac_scarcity_results.json

# Stale copy location — scripts should write to dashboard/ or data/, not here
scripts/dashboard/

# Step 1 raw parquet exports are ignored locally; CI commits them with git add -f
data/step1-pfs-parquets/*
!data/step1-pfs-parquets/.gitkeep

# Large consolidated EIA JSON files — use parquet versions instead
# Pipeline reads parquets via scripts/eia_data_io.py (JSON fallback preserved)
data/EIA 930 Data/eia_generation_profiles.json
data/EIA 930 Data/eia_demand_profiles.json
data/EIA 930 Data/eia_fossil_mix.json
# Per-year raw JSON files — large, regenerated by step0 fetch scripts
data/EIA 930 Data/eia_hourly_*.json
data/EIA 930 Data/eia_demand_*_*.json
data/EIA 930 Data/*_local.json
data/EIA 930 Data/*_backup.json

# CSV exports — large, regenerated from parquets on demand
data/csv-exports/
data/step5-post-processing/csv_exports/

# Archives — local comparison snapshots, not tracked in git
data/archive_*/
