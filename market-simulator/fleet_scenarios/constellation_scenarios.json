  "scenarios": {
    "baseline": {
      "description": "Status quo — no CCS, no new gas, no early retirements. Economic retirements only (driven by market conditions in each sweep scenario).",
      "modifications": []
    },

    "ccs_top_emitters": {
      "description": "CCS retrofit on the 4 largest ERCOT CCGTs (Deer Park, Colorado Bend II, Wolf Hollow II, Guadalupe) by 2030-2032. These 4 plants represent ~4.7 GW and ~10 Mt/yr baseline emissions.",
      "modifications": [
        {"orispl": 55464, "action": "ccs_retrofit", "year_online": 2030},
        {"orispl": 60122, "action": "ccs_retrofit", "year_online": 2030},
