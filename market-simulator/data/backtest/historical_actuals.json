            "emissions_mt": "EPA CAMPD + EIA-923, cross-referenced with eGRID",
            "coal_gw": "EIA-860 generator inventory, retirement notices",
            "gas_price_mmbtu": "EIA Henry Hub natural gas spot prices (annual average)",
            "demand_twh": "EIA-930 Hourly Grid Monitor, EIA Electric Power Monthly"
        },
        "notes": [
            "2020: COVID demand collapse (-3-5% in most ISOs)",
            "2021: Winter Storm Uri (ERCOT, SPP), post-COVID demand recovery",
            "2022: Natural gas price spike ($6.45/MMBtu avg Henry Hub), high LMPs",
            "2023: Gas price correction ($2.57/MMBtu), LMP decline, continued clean growth",
            "2024: Normal conditions, continued renewables deployment, IRA incentives flowing"
        ]
    },

