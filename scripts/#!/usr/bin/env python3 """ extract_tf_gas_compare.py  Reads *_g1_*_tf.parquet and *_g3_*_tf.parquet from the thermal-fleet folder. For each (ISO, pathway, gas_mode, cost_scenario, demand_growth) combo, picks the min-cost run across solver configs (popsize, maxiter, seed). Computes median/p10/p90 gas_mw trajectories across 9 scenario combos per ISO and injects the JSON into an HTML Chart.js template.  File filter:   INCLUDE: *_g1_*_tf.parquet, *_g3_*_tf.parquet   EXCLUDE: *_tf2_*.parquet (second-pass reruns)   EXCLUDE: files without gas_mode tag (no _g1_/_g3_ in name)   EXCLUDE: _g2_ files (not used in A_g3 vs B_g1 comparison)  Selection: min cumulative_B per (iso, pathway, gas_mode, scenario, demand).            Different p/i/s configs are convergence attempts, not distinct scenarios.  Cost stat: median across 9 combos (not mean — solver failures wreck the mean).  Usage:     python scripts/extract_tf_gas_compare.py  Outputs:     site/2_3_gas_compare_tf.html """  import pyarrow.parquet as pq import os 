const IC={CAISO:'#F59E0B',ERCOT:'#22C55E',PJM:'#0EA5E9',NYISO:'#E91E63',NEISO:'#9C27B0',MISO:'#F97316',SPP:'#14B8A6'};const bar=document.getElementById('isoBar'),isos=Object.keys(DATA);let ai=isos.includes('PJM')?'PJM':isos[0],ch=null;
isos.forEach(iso=>{const b=document.createElement('button');b.className='iso-btn'+(iso===ai?' active':'');b.textContent=iso;b.style.background=IC[iso]||'#64748B';b.onclick=()=>{ai=iso;document.querySelectorAll('.iso-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');render()};bar.appendChild(b)});
