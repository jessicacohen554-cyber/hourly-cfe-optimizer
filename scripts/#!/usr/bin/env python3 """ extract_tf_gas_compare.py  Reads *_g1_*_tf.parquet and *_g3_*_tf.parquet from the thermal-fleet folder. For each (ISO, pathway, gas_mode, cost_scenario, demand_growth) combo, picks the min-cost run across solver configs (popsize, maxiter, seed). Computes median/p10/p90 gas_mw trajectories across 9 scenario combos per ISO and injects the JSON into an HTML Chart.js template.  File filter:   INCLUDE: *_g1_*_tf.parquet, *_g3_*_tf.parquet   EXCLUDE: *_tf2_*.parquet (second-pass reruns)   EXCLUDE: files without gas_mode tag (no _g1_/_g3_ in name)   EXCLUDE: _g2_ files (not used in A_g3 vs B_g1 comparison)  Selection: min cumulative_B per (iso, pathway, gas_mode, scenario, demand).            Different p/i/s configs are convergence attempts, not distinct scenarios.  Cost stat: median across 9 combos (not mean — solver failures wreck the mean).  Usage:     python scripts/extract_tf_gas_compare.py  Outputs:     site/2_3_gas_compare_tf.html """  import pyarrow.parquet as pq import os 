const s=document.getElementById('stats'),a=d.A_g3,b=d.B_g1;let h='';
if(a&&b){const pA=Math.max(...a.med.map(p=>p.y)),pB=Math.max(...b.med.map(p=>p.y)),yA=a.med.find(p=>p.y===pA).x,yB=b.med.find(p=>p.y===pB).x,gr=pA>0?((pA-pB)/pA*100).toFixed(0):'–',cd=a.total_cost_B-b.total_cost_B,md=a.dollar_mwh-b.dollar_mwh,sv=cd>0;
