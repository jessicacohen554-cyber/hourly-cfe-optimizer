if(d.A_g3){if(d.A_g3.n>1){ds.push({label:'_Ah',data:d.A_g3.hi,showLine:!0,borderColor:'transparent',backgroundColor:'rgba(239,68,68,0.08)',pointRadius:0,pointHitRadius:0,fill:'+1',order:12});ds.push({label:'_Al',data:d.A_g3.lo,showLine:!0,borderColor:'transparent',backgroundColor:'transparent',pointRadius:0,pointHitRadius:0,fill:!1,order:12})}ds.push({label:'A g3 · gas-blind ('+d.A_g3.n+')',data:d.A_g3.med,showLine:!0,borderColor:'rgba(239,68,68,0.9)',backgroundColor:'transparent',borderWidth:2.5,pointRadius:3.5,pointBackgroundColor:'rgba(239,68,68,0.25)',pointBorderColor:'rgba(239,68,68,0.55)',pointBorderWidth:1.5,pointHoverRadius:7,fill:!1,order:1})}
