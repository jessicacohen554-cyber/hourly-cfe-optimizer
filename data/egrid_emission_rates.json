  "_metadata": {
    "description": "Per-ISO emission rates from EPA eGRID, aggregated by balancing authority",
    "egrid_version": "eGRID 2022 (released 2024). eGRID 2023 available but requires re-extraction.",
    "methodology": "Plant-level data (PLNT22 sheet) aggregated to ISO via BA_CODE mapping. MISO/SPP use generation-weighted average across constituent eGRID sub-regions (RFCW+MROW+SRMW for MISO; SPSO+SPNO for SPP).",
    "units": "lb CO2 / MWh net generation",
    "uncertainty_note": "Year-over-year variation (eGRID 2018-2022): gas rates ±3%, coal rates ±5%, oil rates ±8-12%. Intra-ISO sub-regional variation can be 2-3x (e.g., NYISO Zone J vs upstate).",
    "update_instructions": "Run step0_extract_egrid_baselines.py with eGRID 2023 data to update. MISO/SPP were previously rounded estimates; now use eGRID sub-regional weighted averages."
  }
