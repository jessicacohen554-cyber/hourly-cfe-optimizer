{
  "metadata": {
    "description": "Sequential consequential optimizer \u2014 mines PFS with $/tCO2 objective",
    "methodology": "Greedy path-dependent optimization: at each SBTi threshold, selects the PFS mix that minimizes incremental $/tCO2 subject to floor ratcheting (committed resources cannot decrease). Uses Wright's Law learning curves from pipeline_config mapped to SBTi target years.",
    "scenarios": {
      "all_low": "Best-case costs across the board",
      "all_medium": "Central estimate",
      "all_high": "Worst-case costs",
      "cheap_firm": "High VRE + low firm (what if firm achieves NOAK fast?)",
      "cheap_vre": "Low VRE + high firm (DEFAULT: realistic consequential case)"
    },
    "default_scenario": "cheap_vre",
